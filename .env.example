# ── MedAI Platform environment variables ──
# Copy this file to .env.local and fill in your own values.
# NEVER commit real credentials to the repository.

# Groq API key — powers the AI Health Assistant (/ai-doctor)
# Get one free at: https://console.groq.com
GROQ_API_KEY=

# FastAPI backend base URL (model inference + PDF report generation)
# Local dev:      http://127.0.0.1:8000
# Hugging Face:   https://YOUR-SPACE-NAME.hf.space
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Gmail SMTP for contact form email notifications (optional)
# Use a Gmail "App Password": Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
